<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">
       
    <bean id="chip" class="businessLayer.firstProgram.Autowiring.Chip" >
     <property name="producer" value="NVIDIA"/>
     <property name="power" value="1231"/>
    </bean>
    
     <bean id="Chip1" class="businessLayer.firstProgram.Autowiring.Chip" >
     <property name="producer" value="NVIDIAAA"/>
     <property name="power" value="123111"/>
    </bean>
    
    
     <bean id="Robot" class="businessLayer.firstProgram.Autowiring.Robot" autowire="byName" init-method="display" destroy-method="destory">
    </bean>
</beans>